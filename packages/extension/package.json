{
    "name": "tonto",
    "displayName": "Tonto",
    "publisher": "lenke",
    "description": "Tonto is a DSL for creating OntoUML models",
    "version": "0.4.13",
    "license": "MIT",
    "type": "module",
    "repository": {
        "type": "git",
        "url": "https://github.com/nemo-ufes/Tonto",
        "directory": "packages/extension"
    },
    "icon": "data/images/TontoIcon.png",
    "engines": {
        "vscode": "^1.95.0",
        "node": ">=20.10.0"
    },
    "categories": [
        "Programming Languages"
    ],
    "extensionKind": [
        "ui",
        "workspace"
    ],
    "main": "./pack/extension/main.cjs",
    "contributes": {
        "languages": [
            {
                "id": "tonto",
                "aliases": [
                    "Tonto",
                    "tonto"
                ],
                "extensions": [
                    ".tonto"
                ],
                "configuration": "./data/language-configuration.json"
            },
            {
                "id": "tontodiagram",
                "aliases": [
                    "Tonto Diagram",
                    "tontodiagram"
                ],
                "extensions": [
                    ".tontodiagram"
                ],
                "configuration": "./data/tontodiagram-language-configuration.json"
            },
            {
                "id": "json",
                "extensions": [
                    ".tontoview"
                ]
            }
        ],
        "grammars": [
            {
                "language": "tonto",
                "scopeName": "source.tonto",
                "path": "./syntaxes/tonto.tmLanguage.json"
            },
            {
                "language": "tontodiagram",
                "scopeName": "source.tontodiagram",
                "path": "./syntaxes/tontodiagram.tmLanguage.json"
            }
        ],
        "viewsContainers": {
            "activitybar": [
                {
                    "id": "tonto",
                    "title": "Tonto",
                    "icon": "$(type-hierarchy)"
                }
            ]
        },
        "views": {
            "tonto": [
                {
                    "id": "tontoSidebar",
                    "name": "Tonto sidebar"
                },
                {
                    "id": "tontoCommands",
                    "name": "Commands"
                }
            ],
            "explorer": [
                {
                    "id": "tontoCommandsExplorer",
                    "name": "Tonto Commands"
                }
            ]
        },
        "menus": {
            "commandPalette": [
                {
                    "command": "tonto.diagram.open",
                    "when": "editorLangId == 'tonto'"
                },
                {
                    "command": "tonto.diagram.createFile",
                    "when": "editorLangId == 'tonto' && config.tonto.features.tontodiagram.enabled"
                },
                {
                    "command": "tonto.diagram.fit",
                    "when": "tonto-diagram-focused"
                },
                {
                    "command": "tonto.diagram.center",
                    "when": "tonto-diagram-focused"
                },
                {
                    "command": "tonto.diagram.delete",
                    "when": "tonto-diagram-focused"
                },
                {
                    "command": "tonto.diagram.export",
                    "when": "tonto-diagram-focused"
                }
            ],
            "editor/context": [
                {
                    "command": "tonto.diagram.open",
                    "when": "editorLangId == 'tonto'",
                    "group": "navigation"
                },
                {
                    "command": "tonto.diagram.createFile",
                    "when": "editorLangId == 'tonto' && config.tonto.features.tontodiagram.enabled",
                    "group": "navigation"
                }
            ],
            "editor/title": [
                {
                    "command": "tonto.diagram.open",
                    "when": "editorLangId == 'tonto'",
                    "group": "navigation"
                },
                {
                    "command": "tonto.diagram.plantuml.open",
                    "when": "editorLangId == 'tonto'",
                    "group": "navigation"
                },
                {
                    "command": "tonto.diagram.createFile",
                    "when": "editorLangId == 'tonto' && config.tonto.features.tontodiagram.enabled",
                    "group": "navigation"
                }
            ],
            "explorer/context": [
                {
                    "command": "tonto.diagram.open",
                    "when": "resourceExtname == '.tonto'",
                    "group": "navigation"
                },
                {
                    "command": "tonto.diagram.plantuml.open",
                    "when": "resourceExtname == '.tonto'",
                    "group": "navigation"
                },
                {
                    "command": "tonto.diagram.createFile",
                    "when": "resourceExtname == '.tonto' && config.tonto.features.tontodiagram.enabled",
                    "group": "navigation"
                }
            ],
            "view/title": [],
            "view/item/context": [
                {
                    "command": "tonto.generateJSON",
                    "when": "(view == 'tontoCommandsExplorer' || view == 'tontoCommands') && viewItem == 'tontoCommand'",
                    "group": "navigation"
                },
                {
                    "command": "tonto.generateTonto",
                    "when": "(view == 'tontoCommandsExplorer' || view == 'tontoCommands') && viewItem == 'tontoCommand'",
                    "group": "navigation"
                },
                {
                    "command": "tonto.validateModel",
                    "when": "(view == 'tontoCommandsExplorer' || view == 'tontoCommands') && viewItem == 'tontoCommand'",
                    "group": "navigation"
                },
                {
                    "command": "tonto.transformModel",
                    "when": "(view == 'tontoCommandsExplorer' || view == 'tontoCommands') && viewItem == 'tontoCommand'",
                    "group": "navigation"
                },
                {
                    "command": "tonto.tpm.install",
                    "when": "(view == 'tontoCommandsExplorer' || view == 'tontoCommands') && viewItem == 'tontoCommand'",
                    "group": "navigation"
                },
                {
                    "command": "tonto.initProject",
                    "when": "(view == 'tontoCommandsExplorer' || view == 'tontoCommands') && viewItem == 'tontoCommand'",
                    "group": "navigation"
                },
                {
                    "command": "tonto.addGuidances",
                    "when": "(view == 'tontoCommandsExplorer' || view == 'tontoCommands') && viewItem == 'tontoCommand'",
                    "group": "navigation"
                },
                {
                    "command": "tonto.addSkill",
                    "when": "(view == 'tontoCommandsExplorer' || view == 'tontoCommands') && viewItem == 'tontoCommand'",
                    "group": "navigation"
                },
                {
                    "command": "tonto.addSemanticTokenColors",
                    "when": "(view == 'tontoCommandsExplorer' || view == 'tontoCommands') && viewItem == 'tontoCommand'",
                    "group": "navigation"
                },
                {
                    "command": "tonto.editor.toggleLabelAndDescriptionFolding",
                    "when": "(view == 'tontoCommandsExplorer' || view == 'tontoCommands') && viewItem == 'tontoCommand'",
                    "group": "navigation"
                },
                {
                    "command": "tonto.diagram.plantuml.open",
                    "when": "(view == 'tontoCommandsExplorer' || view == 'tontoCommands') && viewItem == 'tontoCommand'",
                    "group": "navigation"
                },
                {
                    "command": "tonto.diagram.plantuml.export",
                    "when": "(view == 'tontoCommandsExplorer' || view == 'tontoCommands') && viewItem == 'tontoCommand'",
                    "group": "navigation"
                }
            ]
        },
        "jsonValidation": [
            {
                "fileMatch": "*.tontoview",
                "url": "./data/tontoview.schema.json"
            }
        ],
        "configuration": {
            "title": "Tonto",
            "properties": {
                "tonto.features.tontodiagram.enabled": {
                    "type": "boolean",
                    "default": false,
                    "scope": "window",
                    "markdownDescription": "Enable Tonto new diagram visualization with `.tontodiagram` (Alpha feature)."
                },
                "tonto.editor.autoFoldLabelsAndDescriptions": {
                    "type": "boolean",
                    "default": false,
                    "scope": "window",
                    "markdownDescription": "Automatically fold multiline `label` and `description` blocks when a Tonto editor becomes active."
                },
                "tonto.agents.nodePath": {
                    "type": "string",
                    "default": "node",
                    "description": "Node executable used to launch the bundled Tonto MCP server. Requires Node 20.18 or newer."
                }
            }
        },
        "customEditors": [
            {
                "viewType": "tonto",
                "displayName": "Tonto Diagram",
                "selector": [
                    {
                        "filenamePattern": "*.tonto"
                    }
                ],
                "priority": "option"
            },
            {
                "viewType": "tonto.diagram.editor",
                "displayName": "Tonto Diagram Editor",
                "selector": [
                    {
                        "filenamePattern": "*.tontodiagram"
                    }
                ],
                "priority": "default"
            },
            {
                "viewType": "tonto.view.editor",
                "displayName": "Tonto SVG View",
                "selector": [
                    {
                        "filenamePattern": "*.tontoview"
                    }
                ],
                "priority": "default"
            }
        ],
        "commands": [
            {
                "command": "tonto.diagram.open",
                "icon": "$(symbol-structure)",
                "title": "Open Tonto Diagram",
                "category": "Tonto"
            },
            {
                "command": "tonto.diagram.fit",
                "title": "Fit to Screen",
                "category": "Tonto"
            },
            {
                "command": "tonto.diagram.center",
                "title": "Center selection",
                "category": "Tonto"
            },
            {
                "command": "tonto.diagram.delete",
                "title": "Delete selected element",
                "category": "Tonto"
            },
            {
                "command": "tonto.diagram.export",
                "title": "Export diagram to SVG",
                "category": "Tonto"
            },
            {
                "command": "tonto.diagram.createFile",
                "title": "Create Entire Ontology Diagram",
                "category": "Tonto",
                "enablement": "config.tonto.features.tontodiagram.enabled"
            },
            {
                "command": "tonto.generateJSON",
                "title": "Transform Tonto -> JSON",
                "category": "Tonto"
            },
            {
                "command": "tonto.generateTonto",
                "title": "Transform JSON -> Tonto",
                "category": "Tonto"
            },
            {
                "command": "tonto.initProject",
                "title": "Init new Tonto project",
                "category": "Tonto"
            },
            {
                "command": "tonto.validateModel",
                "title": "Validate Model",
                "category": "Tonto"
            },
            {
                "command": "tonto.transformModel",
                "title": "Transform to GUFO",
                "category": "Tonto"
            },
            {
                "command": "tonto.tpm.install",
                "title": "Install Packages (TPM)",
                "category": "Tonto"
            },
            {
                "command": "tonto.addGuidances",
                "title": "Add Guidances to project (Work with LLMs)",
                "category": "Tonto"
            },
            {
                "command": "tonto.addSkill",
                "title": "Add Tonto Skill to project",
                "category": "Tonto"
            },
            {
                "command": "tonto.addSemanticTokenColors",
                "title": "Add Semantic Token Colors to User Settings",
                "category": "Tonto"
            },
            {
                "command": "tonto.editor.toggleLabelAndDescriptionFolding",
                "title": "Toggle Label and Description Folding",
                "category": "Tonto"
            },
            {
                "command": "tonto.diagram.plantuml.open",
                "title": "Open PlantUML Diagram",
                "category": "Tonto"
            },
            {
                "command": "tonto.diagram.plantuml.openProject",
                "title": "Open Ontology PlantUML Diagram",
                "category": "Tonto"
            },
            {
                "command": "tonto.diagram.plantuml.export",
                "title": "Export PlantUML",
                "category": "Tonto"
            },
            {
                "command": "tonto.view.open",
                "title": "Open Named Tonto View",
                "category": "Tonto"
            },
            {
                "command": "tonto.view.saveAs",
                "title": "Save as Named Tonto View",
                "category": "Tonto"
            },
            {
                "command": "tonto.view.convert",
                "title": "Convert to Tonto View",
                "category": "Tonto"
            },
            {
                "command": "tonto.setupAgents",
                "title": "Set Up Agents",
                "category": "Tonto"
            }
        ],
        "keybindings": [
            {
                "key": "alt+f",
                "mac": "alt+f",
                "command": "tonto.diagram.fit",
                "when": "tonto-diagram-focused"
            },
            {
                "key": "alt+c",
                "mac": "alt+c",
                "command": "tonto.diagram.center",
                "when": "tonto-diagram-focused"
            },
            {
                "key": "alt+e",
                "mac": "alt+e",
                "command": "tonto.diagram.export",
                "when": "tonto-diagram-focused"
            },
            {
                "key": "delete",
                "mac": "delete",
                "command": "tonto.diagram.delete",
                "when": "tonto-diagram-focused"
            }
        ],
        "languageModelTools": [
            {
                "name": "tonto_validate",
                "displayName": "Tonto validate",
                "modelDescription": "Parse, link and validate the project. Positions are zero-based UTF-16.",
                "canBeReferencedInPrompt": true,
                "toolReferenceName": "tonto-validate",
                "inputSchema": {
                    "type": "object",
                    "properties": {
                        "source": {
                            "type": "string",
                            "description": "Unsaved text overrides path."
                        },
                        "path": {
                            "type": "string"
                        }
                    },
                    "additionalProperties": false,
                    "$schema": "http://json-schema.org/draft-07/schema#"
                }
            },
            {
                "name": "tonto_ast",
                "displayName": "Tonto ast",
                "modelDescription": "Return linked AST, references, ranges and diagnostics, including partial AST for invalid source.",
                "canBeReferencedInPrompt": true,
                "toolReferenceName": "tonto-ast",
                "inputSchema": {
                    "type": "object",
                    "properties": {
                        "source": {
                            "type": "string",
                            "description": "Unsaved text overrides path."
                        },
                        "path": {
                            "type": "string"
                        }
                    },
                    "additionalProperties": false,
                    "$schema": "http://json-schema.org/draft-07/schema#"
                }
            },
            {
                "name": "tonto_apply",
                "displayName": "Tonto apply",
                "modelDescription": "Preview explicit edits or exactly one editor repair; never saves or holds source.",
                "canBeReferencedInPrompt": true,
                "toolReferenceName": "tonto-apply",
                "inputSchema": {
                    "type": "object",
                    "properties": {
                        "source": {
                            "type": "string",
                            "description": "Unsaved text overrides path."
                        },
                        "path": {
                            "type": "string"
                        },
                        "edits": {
                            "type": "array",
                            "items": {
                                "type": "object",
                                "properties": {
                                    "range": {
                                        "type": "object",
                                        "properties": {
                                            "start": {
                                                "type": "object",
                                                "properties": {
                                                    "line": {
                                                        "type": "integer",
                                                        "minimum": 0
                                                    },
                                                    "character": {
                                                        "type": "integer",
                                                        "minimum": 0
                                                    }
                                                },
                                                "required": [
                                                    "line",
                                                    "character"
                                                ],
                                                "additionalProperties": false
                                            },
                                            "end": {
                                                "type": "object",
                                                "properties": {
                                                    "line": {
                                                        "type": "integer",
                                                        "minimum": 0
                                                    },
                                                    "character": {
                                                        "type": "integer",
                                                        "minimum": 0
                                                    }
                                                },
                                                "required": [
                                                    "line",
                                                    "character"
                                                ],
                                                "additionalProperties": false
                                            }
                                        },
                                        "required": [
                                            "start",
                                            "end"
                                        ],
                                        "additionalProperties": false
                                    },
                                    "newText": {
                                        "type": "string"
                                    }
                                },
                                "required": [
                                    "range",
                                    "newText"
                                ],
                                "additionalProperties": false
                            },
                            "minItems": 1
                        },
                        "diagnosticIndex": {
                            "type": "integer",
                            "minimum": 0
                        },
                        "repairTitle": {
                            "type": "string"
                        }
                    },
                    "additionalProperties": false,
                    "$schema": "http://json-schema.org/draft-07/schema#"
                }
            },
            {
                "name": "tonto_diff",
                "displayName": "Tonto diff",
                "modelDescription": "Compare project diagnostics by URI, code, severity and message, preserving duplicate counts.",
                "canBeReferencedInPrompt": true,
                "toolReferenceName": "tonto-diff",
                "inputSchema": {
                    "type": "object",
                    "properties": {
                        "before": {
                            "type": "string"
                        },
                        "after": {
                            "type": "string"
                        },
                        "path": {
                            "type": "string"
                        }
                    },
                    "required": [
                        "before",
                        "after"
                    ],
                    "additionalProperties": false,
                    "$schema": "http://json-schema.org/draft-07/schema#"
                }
            },
            {
                "name": "tonto_complete",
                "displayName": "Tonto complete",
                "modelDescription": "Editor completion at a zero-based UTF-16 position.",
                "canBeReferencedInPrompt": true,
                "toolReferenceName": "tonto-complete",
                "inputSchema": {
                    "type": "object",
                    "properties": {
                        "source": {
                            "type": "string",
                            "description": "Unsaved text overrides path."
                        },
                        "path": {
                            "type": "string"
                        },
                        "line": {
                            "type": "integer",
                            "minimum": 0
                        },
                        "character": {
                            "type": "integer",
                            "minimum": 0
                        }
                    },
                    "required": [
                        "line",
                        "character"
                    ],
                    "additionalProperties": false,
                    "$schema": "http://json-schema.org/draft-07/schema#"
                }
            },
            {
                "name": "tonto_guide",
                "displayName": "Tonto guide",
                "modelDescription": "Read the current repository grammar guide.",
                "canBeReferencedInPrompt": true,
                "toolReferenceName": "tonto-guide",
                "inputSchema": {
                    "type": "object",
                    "properties": {},
                    "additionalProperties": false,
                    "$schema": "http://json-schema.org/draft-07/schema#"
                }
            },
            {
                "name": "tonto_rules",
                "displayName": "Tonto rules",
                "modelDescription": "Read current validator rule messages.",
                "canBeReferencedInPrompt": true,
                "toolReferenceName": "tonto-rules",
                "inputSchema": {
                    "type": "object",
                    "properties": {},
                    "additionalProperties": false,
                    "$schema": "http://json-schema.org/draft-07/schema#"
                }
            },
            {
                "name": "tonto_tables",
                "displayName": "Tonto tables",
                "modelDescription": "Read supported categories, relations and validator nature tables.",
                "canBeReferencedInPrompt": true,
                "toolReferenceName": "tonto-tables",
                "inputSchema": {
                    "type": "object",
                    "properties": {},
                    "additionalProperties": false,
                    "$schema": "http://json-schema.org/draft-07/schema#"
                }
            },
            {
                "name": "tonto_patterns",
                "displayName": "Tonto patterns",
                "modelDescription": "Read patterns checked against current language services.",
                "canBeReferencedInPrompt": true,
                "toolReferenceName": "tonto-patterns",
                "inputSchema": {
                    "type": "object",
                    "properties": {},
                    "additionalProperties": false,
                    "$schema": "http://json-schema.org/draft-07/schema#"
                }
            },
            {
                "name": "tonto_explain",
                "displayName": "Tonto explain",
                "modelDescription": "Explain a validator diagnostic or language term using current knowledge.",
                "canBeReferencedInPrompt": true,
                "toolReferenceName": "tonto-explain",
                "inputSchema": {
                    "type": "object",
                    "properties": {
                        "term": {
                            "type": "string",
                            "minLength": 1
                        }
                    },
                    "required": [
                        "term"
                    ],
                    "additionalProperties": false,
                    "$schema": "http://json-schema.org/draft-07/schema#"
                }
            },
            {
                "name": "tonto_format",
                "displayName": "Tonto format",
                "modelDescription": "Preview the current language formatter output without saving.",
                "canBeReferencedInPrompt": true,
                "toolReferenceName": "tonto-format",
                "inputSchema": {
                    "type": "object",
                    "properties": {
                        "source": {
                            "type": "string",
                            "description": "Unsaved text overrides path."
                        },
                        "path": {
                            "type": "string"
                        }
                    },
                    "additionalProperties": false,
                    "$schema": "http://json-schema.org/draft-07/schema#"
                }
            },
            {
                "name": "tonto_digest",
                "displayName": "Tonto digest",
                "modelDescription": "Summarize declarations in the linked model and its diagnostics.",
                "canBeReferencedInPrompt": true,
                "toolReferenceName": "tonto-digest",
                "inputSchema": {
                    "type": "object",
                    "properties": {
                        "source": {
                            "type": "string",
                            "description": "Unsaved text overrides path."
                        },
                        "path": {
                            "type": "string"
                        }
                    },
                    "additionalProperties": false,
                    "$schema": "http://json-schema.org/draft-07/schema#"
                }
            },
            {
                "name": "tonto_repair",
                "displayName": "Tonto repair",
                "modelDescription": "Preview unambiguous editor repairs, revalidate and return unsaved source.",
                "canBeReferencedInPrompt": true,
                "toolReferenceName": "tonto-repair",
                "inputSchema": {
                    "type": "object",
                    "properties": {
                        "source": {
                            "type": "string",
                            "description": "Unsaved text overrides path."
                        },
                        "path": {
                            "type": "string"
                        }
                    },
                    "additionalProperties": false,
                    "$schema": "http://json-schema.org/draft-07/schema#"
                }
            },
            {
                "name": "tonto_gufo",
                "displayName": "Tonto gufo",
                "modelDescription": "Preview the existing OntoUML gUFO transformation without writing files.",
                "canBeReferencedInPrompt": true,
                "toolReferenceName": "tonto-gufo",
                "inputSchema": {
                    "type": "object",
                    "properties": {
                        "source": {
                            "type": "string",
                            "description": "Unsaved text overrides path."
                        },
                        "path": {
                            "type": "string"
                        },
                        "label": {
                            "type": "string"
                        },
                        "description": {
                            "type": "string"
                        }
                    },
                    "additionalProperties": false,
                    "$schema": "http://json-schema.org/draft-07/schema#"
                }
            }
        ]
    },
    "activationEvents": [
        "workspaceContains:tonto.json",
        "onWebviewPanel:tonto",
        "onView:tonto",
        "onLanguage:tontodiagram",
        "onCommand:tonto.addSemanticTokenColors",
        "onCommand:tonto.diagram.createFile",
        "onCustomEditor:tonto.diagram.editor",
        "onLanguage:tontoview",
        "onCustomEditor:tonto.view.editor",
        "onCommand:tonto.setupAgents"
    ],
    "files": [
        "pack/**/*.cjs",
        "pack/**/*.mjs",
        "pack/webview/**/*.js",
        "pack/webview/**/*.css",
        "pack/licenses/**",
        "src/themes",
        "data",
        "LICENSE.md",
        "syntaxes"
    ],
    "vsce": {
        "dependencies": true,
        "yarn": false
    },
    "scripts": {
        "copy:schema": "shx cp ../tonto/tonto-manifest-schema.json ./data",
        "vscode:prepublish": "npm run build && node ./esbuild.mjs --minify",
        "package": "vsce package --allow-package-all-secrets",
        "publish": "vsce publish --allow-package-all-secrets",
        "clean": "rimraf out pack node_modules",
        "lint": "eslint src --ext ts",
        "lint:fix": "eslint src --ext ts --fix",
        "build": "npm --prefix ../tonto run langium:generate && npm --prefix ../webview run build && node ./esbuild.mjs",
        "watch": "concurrently \"npm --prefix ../webview run watch\" \"node ./esbuild.mjs --watch\"",
        "coverage": "vitest run --coverage",
        "langium:generate": "langium generate",
        "langium:watch": "langium generate --watch",
        "publish:npm": "npm publish --access public",
        "prepare:public": "node scripts/prepare-public.mjs"
    },
    "dependencies": {
