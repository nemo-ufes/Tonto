{
    "name": "tonto-cli",
    "displayName": "Tonto CLI",
    "publisher": "Lenke",
    "author": {
        "name": "Matheus Lenke Coutinho",
        "email": "matheuslenke@gmail.com"
    },
    "type": "module",
    "description": "Tonto is a DSL for creating OntoUML models",
    "version": "0.4.14",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/nemo-ufes/Tonto.git",
        "directory": "packages/tonto"
    },
    "engines": {
        "node": ">=20.10.0"
    },
    "categories": [
        "Programming Languages"
    ],
    "files": [
        "lib",
        "lib/cli",
        "src",
        "MCP.md",
        "scripts/watch-grammar.mjs",
        "tonto-manifest-schema.json"
    ],
    "bin": {
        "tonto-cli": "bin/cli.js",
        "tonto-mcp": "bin/mcp.js"
    },
    "exports": {
        ".": "./lib/index.js",
        "./lib/*": "./lib/*"
    },
    "types": "lib/index.d.ts",
    "main": "lib/index",
    "scripts": {
        "clean": "shx rm -rf lib coverage tsconfig.tsbuildinfo",
        "prebuild": "npm run clean",
        "build": "tsc",
        "watch": "tsc --watch",
        "test": "vitest",
        "test-ui": "vitest --ui",
        "lint": "eslint src test --ext .ts",
        "lint:fix": "eslint src --fix --ext ts",
        "langium:generate": "langium generate",
        "langium:watch": "node scripts/watch-grammar.mjs",
        "publish": "npm publish",
        "publish:latest": "npm publish --tag latest"
    },
    "dependencies": {
        "@inquirer/prompts": "^7.8.6",
        "@modelcontextprotocol/sdk": "^1.32.1",
        "@vscode/vsce": "3.3.2",
        "chalk": "^5.6.2",
        "chevrotain": "13.2.0",
        "chevrotain-allstar": "0.5.0",
        "concurrently": "3.5.1",
        "elkjs": "^0.10.0",
        "glob": "^10.2.2",
        "langium": "4.4.0",
        "langium-sprotty": "4.4.0",
        "node-fetch-native": "^1.0.1",
        "ontouml-js": "github:matheuslenke/ontouml-js#feature/include-types-in-build",
        "reflect-metadata": "^0.2.2",
        "rimraf": "^4.1.2",
        "sprotty": "^1.2.0",
        "sprotty-elk": "^1.2.0",
        "uuid": "^9.0.1",
        "vscode-languageclient": "~9.0.1",
        "vscode-languageserver": "~10.1.0",
        "vscode-languageserver-types": "~3.18.0",
        "vscode-uri": "^3.0.7",
        "zod": "^3.25.76",
        "vscode-languageserver-protocol": "~3.18.2"
    },
    "devDependencies": {
        "@types/jest": "^29.2.3",
        "@types/node": "^18.11.17",
        "@types/node-fetch": "^2.6.1",
        "@types/uuid": "^9.0.8",
        "@types/vscode": "^1.63.0",
        "@vitest/coverage-c8": "^0.33.0",
        "langium-cli": "4.4.0"
    }
}
